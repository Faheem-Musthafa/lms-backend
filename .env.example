# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="LMS Backend"
ENVIRONMENT=local              # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# async driver (app runtime)
DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms
# sync driver (alembic) — derived automatically if omitted
DATABASE_SYNC_URL=postgresql+psycopg://lms:lms@localhost:5432/lms
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security / JWT ───────────────────────────────────────────────────────────
# generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-please-32-bytes-minimum-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900           # 15 min
REFRESH_TOKEN_TTL_SECONDS=2592000      # 30 days
PASSWORD_RESET_TTL_SECONDS=3600        # 1 hour

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_AUTH="10/minute"

# ── Tenancy ──────────────────────────────────────────────────────────────────
TENANT_HEADER=X-Tenant-ID
ENABLE_ROW_LEVEL_SECURITY=true

# ── Object storage (optional) ────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=lms-assets
S3_REGION=us-east-1

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
